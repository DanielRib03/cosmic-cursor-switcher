#!/usr/bin/env python3
"""Seletor de temas de cursor para o COSMIC (Pop!_OS)."""

import os
import re
import struct
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, GLib, Gtk  # noqa: E402

APP_ID = "io.github.ribasdo.CursorSwitcher"
HOME = Path.home()
ICON_DIRS = [
    HOME / ".local/share/icons",
    HOME / ".icons",
    Path("/usr/local/share/icons"),
    Path("/usr/share/icons"),
]
ENV_FILE = HOME / ".config/environment.d/cursor.conf"
DEFAULT_THEME_FILE = HOME / ".icons/default/index.theme"
SIZES = [16, 24, 32, 48, 64, 96]
PREVIEW_CURSORS = ["left_ptr", "hand2", "xterm", "watch"]
PREVIEW_SIZE = 32


# --- Leitura de arquivos Xcursor ------------------------------------------

def load_xcursor(path, want=PREVIEW_SIZE):
    """Retorna (Gdk.Texture, xhot, yhot) da imagem mais próxima de `want`."""
    try:
        data = Path(path).read_bytes()
    except OSError:
        return None
    if data[:4] != b"Xcur":
        return None
    _, _, ntoc = struct.unpack_from("<III", data, 4)
    images = []
    for i in range(ntoc):
        typ, subtype, pos = struct.unpack_from("<III", data, 16 + i * 12)
        if typ == 0xFFFD0002:
            images.append((subtype, pos))
    if not images:
        return None
    _, pos = min(images, key=lambda im: (abs(im[0] - want), -im[0]))
    _, _, _, _, w, h, xhot, yhot, _ = struct.unpack_from("<9I", data, pos)
    pixels = data[pos + 36 : pos + 36 + w * h * 4]
    texture = Gdk.MemoryTexture.new(
        w, h, Gdk.MemoryFormat.B8G8R8A8_PREMULTIPLIED, GLib.Bytes.new(pixels), w * 4
    )
    return texture, xhot, yhot


# --- Descoberta de temas ----------------------------------------------------

def theme_display_name(theme_dir):
    index = theme_dir / "index.theme"
    if index.is_file():
        m = re.search(r"^Name\s*=\s*(.+)$", index.read_text(errors="ignore"), re.M)
        if m:
            return m.group(1).strip()
    return theme_dir.name


def find_themes():
    themes = {}
    for base in ICON_DIRS:
        if not base.is_dir():
            continue
        for d in sorted(base.iterdir()):
            if d.name == "default" or d.name in themes:
                continue
            if (d / "cursors").is_dir():
                themes[d.name] = {"dir": d, "label": theme_display_name(d)}
    return dict(sorted(themes.items(), key=lambda kv: kv[1]["label"].lower()))


# --- Configuração atual / aplicação ----------------------------------------

def read_current():
    theme = os.environ.get("XCURSOR_THEME", "")
    size = int(os.environ.get("XCURSOR_SIZE", "24") or 24)
    if ENV_FILE.is_file():
        for line in ENV_FILE.read_text().splitlines():
            key, _, val = line.partition("=")
            if key.strip() == "XCURSOR_THEME":
                theme = val.strip()
            elif key.strip() == "XCURSOR_SIZE" and val.strip().isdigit():
                size = int(val.strip())
    return theme, size


def apply_theme(theme, size):
    # 1. Variáveis de ambiente lidas pelo cosmic-comp ao iniciar a sessão
    ENV_FILE.parent.mkdir(parents=True, exist_ok=True)
    ENV_FILE.write_text(f"XCURSOR_THEME={theme}\nXCURSOR_SIZE={size}\n")

    # 2. Tema "default" (fallback do libXcursor / apps X11)
    DEFAULT_THEME_FILE.parent.mkdir(parents=True, exist_ok=True)
    DEFAULT_THEME_FILE.write_text(f"[Icon Theme]\nInherits={theme}\n")

    # 3. GSettings (apps GTK aplicam na hora)
    for key, val in (("cursor-theme", theme), ("cursor-size", str(size))):
        subprocess.run(
            ["gsettings", "set", "org.gnome.desktop.interface", key, val],
            check=False,
        )

    # 4. Ambiente do systemd/dbus para apps abertos a partir de agora
    subprocess.run(
        ["dbus-update-activation-environment", "--systemd",
         f"XCURSOR_THEME={theme}", f"XCURSOR_SIZE={size}"],
        check=False,
    )


# --- Interface --------------------------------------------------------------

class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Temas de Cursor")
        self.set_default_size(560, 640)

        self.themes = find_themes()
        self.current_theme, self.current_size = read_current()
        self.selected = self.current_theme

        self.toast_overlay = Adw.ToastOverlay()
        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        self.apply_btn = Gtk.Button(label="Aplicar")
        self.apply_btn.add_css_class("suggested-action")
        self.apply_btn.connect("clicked", self.on_apply)
        header.pack_end(self.apply_btn)
        toolbar.add_top_bar(header)

        page = Adw.PreferencesPage()

        size_group = Adw.PreferencesGroup(title="Tamanho")
        self.size_row = Adw.ComboRow(title="Tamanho do cursor")
        sizes = sorted(set(SIZES) | {self.current_size})
        self.sizes = sizes
        self.size_row.set_model(Gtk.StringList.new([f"{s} px" for s in sizes]))
        self.size_row.set_selected(sizes.index(self.current_size))
        self.size_row.connect("notify::selected", lambda *_: self.update_apply())
        size_group.add(self.size_row)
        page.add(size_group)

        group = Adw.PreferencesGroup(
            title="Temas instalados",
            description="Passe o mouse sobre um tema para testá-lo.",
        )
        first_check = None
        for name, info in self.themes.items():
            row = Adw.ActionRow(title=info["label"], subtitle=str(info["dir"]), subtitle_lines=1)
            check = Gtk.CheckButton(valign=Gtk.Align.CENTER)
            if first_check:
                check.set_group(first_check)
            else:
                first_check = check
            check.set_active(name == self.current_theme)
            check.connect("toggled", self.on_toggled, name)
            row.add_prefix(check)
            row.set_activatable_widget(check)

            previews = Gtk.Box(spacing=6, valign=Gtk.Align.CENTER)
            for cname in PREVIEW_CURSORS:
                cur = load_xcursor(info["dir"] / "cursors" / cname)
                if not cur:
                    continue
                img = Gtk.Image.new_from_paintable(cur[0])
                img.set_pixel_size(PREVIEW_SIZE)
                previews.append(img)
                if cname == "left_ptr":
                    row.set_cursor(Gdk.Cursor.new_from_texture(cur[0], cur[1], cur[2], None))
            row.add_suffix(previews)
            group.add(row)
        page.add(group)

        toolbar.set_content(page)
        self.toast_overlay.set_child(toolbar)
        self.set_content(self.toast_overlay)
        self.update_apply()

    def selected_size(self):
        return self.sizes[self.size_row.get_selected()]

    def on_toggled(self, check, name):
        if check.get_active():
            self.selected = name
            self.update_apply()

    def update_apply(self):
        self.apply_btn.set_sensitive(
            bool(self.selected)
            and (self.selected, self.selected_size()) != (self.current_theme, self.current_size)
        )

    def on_apply(self, _btn):
        size = self.selected_size()
        apply_theme(self.selected, size)
        self.current_theme, self.current_size = self.selected, size
        self.update_apply()
        toast = Adw.Toast(
            title="Tema aplicado. Encerre a sessão para valer em todo o sistema.",
            button_label="Encerrar sessão",
            timeout=0,
        )
        toast.connect("button-clicked", lambda *_: subprocess.Popen(["cosmic-osd", "log-out"]))
        self.toast_overlay.add_toast(toast)


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        win = self.get_active_window() or Window(self)
        win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
